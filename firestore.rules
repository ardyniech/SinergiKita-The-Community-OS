rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function hasUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['ardy.syafii@gmail.com', 'ardy.syafii@sinergikita.id'] ||
        (hasUserData() && getUserData().role == 'superadmin' && getUserData().isApproved == true)
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (hasUserData() && getUserData().role in ['admin', 'ketua', 'bendahara', 'sekretaris', 'Admin'] && getUserData().isApproved == true)
      );
    }

    function isMemberOf(tenantId) {
      return isSignedIn() && hasUserData() && getUserData().tenantId == tenantId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // ---------------------------------------------------------
    // Global Safety Net
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ---------------------------------------------------------
    // Tenants
    // ---------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || request.auth.uid == request.resource.data.ownerId);
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == resource.data.ownerId);
      allow delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------
    // Users
    // ---------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Allow list/query of users if admin, or if matching the user's verified email (for invitations)
      allow list: if isSignedIn() && (
        (isAdmin() && hasUserData() && resource.data.tenantId == getUserData().tenantId) ||
        resource.data.email == request.auth.token.email
      );
      
      // Allow profile creation for self, or registration by admin
      allow create: if isSignedIn() && (
        request.auth.uid == userId || 
        (isAdmin() && hasUserData() && request.resource.data.tenantId == getUserData().tenantId)
      );
      
      allow update: if isSignedIn() && (
        // Case 1: Owner updating their own non-sensitive fields when already in a community
        (request.auth.uid == userId && 
         resource.data.tenantId != null && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'address', 'photoURL', 'email', 'updatedAt', 'observations', 'status'])) ||
         
        // Case 2: Owner joining or creating a community for the first time (when tenantId is null/absent)
        (request.auth.uid == userId && 
         (!resource.data.keys().hasAll(['tenantId']) || resource.data.tenantId == null) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tenantId', 'role', 'isApproved', 'displayName', 'phoneNumber', 'address', 'photoURL', 'email', 'updatedAt', 'status']) &&
         request.resource.data.isApproved == false) ||
         
        // Case 3: Admin of the community updating member details
        (isAdmin() && 
         hasUserData() && 
         resource.data.tenantId == getUserData().tenantId &&
         request.resource.data.tenantId == resource.data.tenantId)
      );
    }

    // ---------------------------------------------------------
    // Transactions
    // ---------------------------------------------------------
    match /transactions/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isAdmin() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId) && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Proposals
    // ---------------------------------------------------------
    match /proposals/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow delete: if isAdmin() && isMemberOf(resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Emergencies
    // ---------------------------------------------------------
    match /emergencies/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Recurring
    // ---------------------------------------------------------
    match /recurring/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isAdmin() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId) && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Social Alerts
    // ---------------------------------------------------------
    match /social_alerts/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Products
    // ---------------------------------------------------------
    match /products/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Koperasi
    // ---------------------------------------------------------
    match /koperasi/{id} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.uid || (isAdmin() && isMemberOf(resource.data.tenantId)));
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || (isAdmin() && isMemberOf(resource.data.tenantId)));
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId) && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Projects
    // ---------------------------------------------------------
    match /projects/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isSignedIn() && isMemberOf(resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Learning
    // ---------------------------------------------------------
    match /learning/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Announcements
    // ---------------------------------------------------------
    match /announcements/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Messages
    // ---------------------------------------------------------
    match /messages/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Transaction Approvals
    // ---------------------------------------------------------
    match /transaction_approvals/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Santunan Claims
    // ---------------------------------------------------------
    match /santunan_claims/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(request.resource.data.tenantId);
      allow delete: if isAdmin() && isMemberOf(resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Audit Logs
    // ---------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if isAdmin() && (isSuperAdmin() || (hasUserData() && resource.data.tenantId == getUserData().tenantId));
      allow list: if isAdmin() && (isSuperAdmin() || (hasUserData() && resource.data.tenantId == getUserData().tenantId));
      allow create: if isSignedIn() && (isSuperAdmin() || (hasUserData() && request.resource.data.tenantId == getUserData().tenantId));
    }
  }
}
