rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function hasUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (hasUserData() && getUserData().role == 'superadmin')
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        (hasUserData() && getUserData().role in ['admin', 'ketua', 'bendahara', 'sekretaris'] && getUserData().isApproved == true)
      );
    }

    function isMemberOf(tenantId) {
      return isSignedIn() &&
             hasUserData() &&
             getUserData().tenantId == tenantId &&
             (getUserData().isApproved == true || getUserData().role == 'superadmin');
    }

    function isMemberOfNoApproval(tenantId) {
      return isSignedIn() &&
             hasUserData() &&
             getUserData().tenantId == tenantId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // ---------------------------------------------------------
    // Global Safety Net
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ---------------------------------------------------------
    // Tenants
    // ---------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (isMemberOfNoApproval(tenantId) || isSuperAdmin());
      allow create: if isSignedIn() && (isSuperAdmin() || request.auth.uid == request.resource.data.ownerId);
      allow update: if isSignedIn() && (isSuperAdmin() || request.auth.uid == resource.data.ownerId);
      allow delete: if isSuperAdmin();

      match /members/{memberUid} {
        allow read: if isSignedIn() && (
          request.auth.uid == memberUid || 
          isMemberOf(tenantId)
        );
        allow create, update: if isSignedIn() && (
          request.auth.uid == memberUid || 
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------
    // Users (Fixed N1 & N2)
    // ---------------------------------------------------------
    match /users/{userId} {
      // Read: self, or same tenant if admin or regular user (N2 fix: explicit tenant checks)
      allow read, list: if isSignedIn() && (
        request.auth.uid == userId || 
        (hasUserData() && resource.data.tenantId == getUserData().tenantId) ||
        resource.data.email == request.auth.token.email
      );
      
      // Create: User can only create their own doc. Must NOT be superadmin. (N1 fix)
      allow create: if request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['member','admin','ketua','bendahara','sekretaris']
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','tenantId','role','isApproved', 'address', 'phoneNumber', 'createdAt', 'status', 'tenantName'])
        && (request.resource.data.tenantId is string || request.resource.data.tenantId == null);
      
      // Update: User can update their own non-sensitive fields. Admin can update within same tenant. (N1/N2 fix)
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','tenantId', 'address', 'phoneNumber', 'tenantName']) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isApproved == resource.data.isApproved) ||
        (isAdmin() && hasUserData() && resource.data.tenantId == getUserData().tenantId && request.resource.data.tenantId == resource.data.tenantId &&
         request.resource.data.role in ['member','admin','ketua','bendahara','sekretaris'] &&
         (request.auth.uid != userId || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved'])))
      );

      allow delete: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        (isAdmin() && hasUserData() && resource.data.tenantId == getUserData().tenantId)
      );
    }
    // ---------------------------------------------------------
    // Transactions & Finance
    // ---------------------------------------------------------
    match /transactions/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isAdmin() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId);
    }
    match /recurring/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
    match /dues_billings/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update, delete: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
    match /dues_payments/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId) && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId) && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Koperasi
    // ---------------------------------------------------------
    match /koperasi/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update, delete: if isAdmin() && isMemberOf(resource.data.tenantId);
    }
    match /koperasi_loans/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if (isAdmin() && isMemberOf(resource.data.tenantId)) ||
                      (isSignedIn() && resource.data.uid == request.auth.uid && isMemberOf(resource.data.tenantId));
    }

    // ---------------------------------------------------------
    // Funding
    // ---------------------------------------------------------
    match /funding_projects/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isSignedIn() && isMemberOf(resource.data.tenantId);
    }
    match /funding_contributions/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Marketplace
    // ---------------------------------------------------------
    match /marketplace_products/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update, delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        (isAdmin() && isMemberOf(resource.data.tenantId))
      );
    }
    match /marketplace_orders/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId) && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId ||
        isAdmin()
      );
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isSignedIn() && (isAdmin() && isMemberOf(resource.data.tenantId));
    }

    // ---------------------------------------------------------
    // Social Feed
    // ---------------------------------------------------------
    match /social_posts/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update, delete: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (isAdmin() && isMemberOf(resource.data.tenantId))
      );

      match /likes/{userId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /post_comments/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Direct Messages & Conversations
    match /social_conversations/{convId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // Watch Requests (Minta Pantau - Ojol / Safety)
    match /watch_requests/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId) && request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow delete: if isSignedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());
    }

    // Gagasan Komunitas (PR-31)
    match /community_ideas/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId) && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isMemberOf(resource.data.tenantId) && (
        resource.data.authorId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Moderation Reports & Immutable Audit
    match /social_reports/{reportId} {
      allow read: if isSignedIn() && isAdmin() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isSignedIn() && isAdmin() && isMemberOf(resource.data.tenantId);
      allow delete: if isSuperAdmin();
    }
    match /modAudit/{auditId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // strictly immutable
    }

    // ---------------------------------------------------------
    // POS System
    // ---------------------------------------------------------
    match /pos_products/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
    match /pos_transactions/{id} {
      allow read, list: if isSignedIn() && (isAdmin() || isMemberOf(resource.data.tenantId));
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Learning
    // ---------------------------------------------------------
    match /learning_lessons/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
    match /user_learning_progress/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // Proposals & SOS
    // ---------------------------------------------------------
    match /proposals/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow delete: if isAdmin() && isMemberOf(resource.data.tenantId);
    }
    match /emergencies/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
      allow update: if isAdmin() && isMemberOf(resource.data.tenantId);
    }
    match /social_alerts/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }
    match /announcements/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }

    // ---------------------------------------------------------
    // Utils (Audit, Locations, etc)
    // ---------------------------------------------------------
    match /active_locations/{id} {
      allow read, list: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow create, update: if isSignedIn() && request.auth.uid == id && isMemberOfNoApproval(request.resource.data.tenantId);
    }
    match /audit_logs/{id} {
      allow read, list: if isAdmin() && isMemberOf(resource.data.tenantId);
      allow create: if isSignedIn() && isMemberOf(request.resource.data.tenantId);
    }
    match /insights_cache/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
    match /smart_tips_cache/{id} {
      allow read: if isSignedIn() && isMemberOf(resource.data.tenantId);
      allow write: if isAdmin() && isMemberOf(request.resource.data.tenantId);
    }
  }
}
