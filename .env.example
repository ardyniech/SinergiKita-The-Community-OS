# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model to use (default: gemini-1.5-flash or gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-1.5-flash"

# SUPERADMIN_EMAILS: Comma-separated list of master admin emails
SUPERADMIN_EMAILS="ardy.syafii@gmail.com,ardy.syafii@sinergikita.id"
VITE_SUPERADMIN_EMAILS="ardy.syafii@gmail.com,ardy.syafii@sinergikita.id"

# Database Configuration (PostgreSQL / Drizzle)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="sinergikita"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
