# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model to use (default: gemini-1.5-flash or gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-1.5-flash"

# SUPERADMIN_EMAILS: Server-only. Comma-separated master admin emails used for
# server-side authorization (API authz). Never prefix with VITE_ — that would leak
# these emails into the client bundle.
SUPERADMIN_EMAILS="ardy.syafii@gmail.com,ardy.syafii@sinergikita.id"

# VITE_SUPERADMIN_EMAILS: Client-only. REQUIRED for first-sign-in auto-approval of
# superadmin emails (see src/context/AuthContext.tsx). NOTE: this exposes the superadmin
# emails in the shipped JS bundle. Acceptable only because the server (server/utils/superadmin.ts)
# is the source of truth for authz. To remove this leak, move superadmin role assignment
# server-side (e.g. stamp role:'superadmin' on signup via an API endpoint) and drop this var.
VITE_SUPERADMIN_EMAILS="ardy.syafii@gmail.com,ardy.syafii@sinergikita.id"

# Database Configuration (PostgreSQL / Drizzle)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="sinergikita"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
