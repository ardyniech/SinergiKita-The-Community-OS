{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "A community or residential area (RT/RW).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the community." },
        "status": { "type": "string", "enum": ["pending", "approved", "suspended"], "description": "Approval status." },
        "ownerId": { "type": "string", "description": "UID of the user who created the community." },
        "createdAt": { "type": "number", "description": "Timestamp in milliseconds." },
        "enabledModules": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string" }
      },
      "required": ["name", "status", "ownerId", "createdAt"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "User profile with role and tenant association.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "admin", "member"] },
        "tenantId": { "type": "string", "description": "ID of the tenant the user belongs to." },
        "isApproved": { "type": "boolean" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "rating": { "type": "number" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "points": { "type": "number" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "isCritical": { "type": "boolean" },
        "observations": { "type": "string" },
        "evaluationNote": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial record for a tenant.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "description": { "type": "string" },
        "date": { "type": "string", "description": "ISO date string or localized string." },
        "category": { "type": "string" }
      },
      "required": ["tenantId", "amount", "type", "description", "date"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Community proposal for voting.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "yesVotes": { "type": "number" },
        "noVotes": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "closed", "approved", "rejected"] }
      },
      "required": ["tenantId", "title", "description", "status"]
    },
    "Emergency": {
      "title": "Emergency",
      "description": "Emergency SOS alert.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["security", "medical", "fire", "other"] },
        "senderName": { "type": "string" },
        "senderAddress": { "type": "string" },
        "senderId": { "type": "string" },
        "tenantId": { "type": "string" },
        "timestamp": { "type": "object", "description": "Server timestamp or number." },
        "latitude": { "type": "number", "description": "GPS latitude of the SOS sender." },
        "longitude": { "type": "number", "description": "GPS longitude of the SOS sender." },
        "locationAccuracy": { "type": "number", "description": "Accuracy of the GPS coordinates in meters." }
      },
      "required": ["type", "senderName", "senderAddress", "senderId", "tenantId"]
    },
    "RecurringTransaction": {
      "title": "RecurringTransaction",
      "description": "A monthly recurring transaction template.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "nextBillingDate": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["tenantId", "description", "amount", "status"]
    },
    "SocialAlert": {
      "title": "SocialAlert",
      "description": "Community social info or welfare alert.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string" },
        "helpers": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["tenantId", "title", "description"]
    },
    "Product": {
      "title": "Product",
      "description": "Product for sale in the community shop.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "stock": { "type": "number" }
      },
      "required": ["tenantId", "name", "price"]
    },
    "KoperasiDeposit": {
      "title": "KoperasiDeposit",
      "description": "A record of deposit or withdrawal in the cooperative.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "uid": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal"] },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["tenantId", "uid", "type", "amount"]
    },
    "KoperasiLoan": {
      "title": "KoperasiLoan",
      "description": "A record of loan application and status.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "uid": { "type": "string" },
        "borrowerName": { "type": "string" },
        "amount": { "type": "number" },
        "tenorMonths": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["tenantId", "uid", "amount", "status"]
    },
    "FundingProject": {
      "title": "FundingProject",
      "description": "Crowdfunding project for the community.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "uid": { "type": "string" },
        "ownerName": { "type": "string" },
        "title": { "type": "string" },
        "target": { "type": "number" },
        "collectedAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "title", "target", "status"]
    },
    "FundingContribution": {
      "title": "FundingContribution",
      "description": "A member contribution to a funding project.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "object" }
      },
      "required": ["tenantId", "projectId", "userId", "amount"]
    },
    "MarketplaceProduct": {
      "title": "MarketplaceProduct",
      "description": "Product for sale in the marketplace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "sellerId": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "sellerId", "title", "price"]
    },
    "MarketplaceOrder": {
      "title": "MarketplaceOrder",
      "description": "An order in the marketplace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "productId": { "type": "string" },
        "buyerId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "productId", "buyerId", "amount"]
    },
    "SocialPost": {
      "title": "SocialPost",
      "description": "Community social feed post.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "likes": { "type": "array" }
      },
      "required": ["tenantId", "authorId", "content"]
    },
    "POSProduct": {
      "title": "POSProduct",
      "description": "Product for the POS system.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" }
      },
      "required": ["tenantId", "name", "price"]
    },
    "POSTransaction": {
      "title": "POSTransaction",
      "description": "POS transaction record.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "timestamp": { "type": "object" }
      },
      "required": ["tenantId", "totalAmount"]
    },
    "LearningLesson": {
      "title": "LearningLesson",
      "description": "Educational material.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["tenantId", "title", "content"]
    },
    "LearningContent": {
      "title": "LearningContent",
      "description": "Educational materials or guides provided by community admins.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["tenantId", "title", "content", "authorId"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Latest information and news for the community.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "authorName": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["tenantId", "title", "content"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Communication messages between members and admins.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["tenantId", "senderId", "text"]
    },
    "AuditEntry": {
      "title": "AuditEntry",
      "description": "System audit log for tracking user actions.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "action": { "type": "string" },
        "user": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["tenantId", "action", "user", "timestamp"]
    },
    "ActiveLocation": {
      "title": "ActiveLocation",
      "description": "Real-time active GPS location of a member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "tenantId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "updatedAt": { "type": "object" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["uid", "tenantId", "latitude", "longitude"]
    }
  },
  "firestore": {
    "tenants": {
      "schema": "Tenant",
      "description": "Root collection for all communities."
    },
    "users": {
      "schema": "AppUser",
      "description": "Root collection for all users."
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Financial records filtered by tenantId."
    },
    "proposals": {
      "schema": "Proposal",
      "description": "Community proposals filtered by tenantId."
    },
    "emergencies": {
      "schema": "Emergency",
      "description": "Emergency alerts filtered by tenantId."
    },
    "recurring": {
      "schema": "RecurringTransaction",
      "description": "Monthly recurring transactions."
    },
    "social_alerts": {
      "schema": "SocialAlert",
      "description": "Social welfare info."
    },
    "marketplace_products": {
      "schema": "MarketplaceProduct",
      "description": "Shop products."
    },
    "marketplace_orders": {
      "schema": "MarketplaceOrder",
      "description": "Shop orders."
    },
    "koperasi_loans": {
      "schema": "KoperasiLoan",
      "description": "Cooperative transactions."
    },
    "funding_projects": {
      "schema": "FundingProject",
      "description": "Crowdfunding projects."
    },
    "funding_contributions": {
      "schema": "FundingContribution",
      "description": "Contributions to projects."
    },
    "learning_lessons": {
      "schema": "LearningLesson",
      "description": "Educational materials and guides."
    },
    "announcements": {
      "schema": "Announcement",
      "description": "Latest community news."
    },
    "messages": {
      "schema": "ChatMessage",
      "description": "Community communication channel."
    },
    "audit_logs": {
      "schema": "AuditEntry",
      "description": "System activity logs."
    },
    "active_locations": {
      "schema": "ActiveLocation",
      "description": "Real-time active member GPS locations."
    },
    "social_posts": {
      "schema": "SocialPost",
      "description": "Social feed posts."
    },
    "pos_products": {
      "schema": "POSProduct",
      "description": "POS inventory."
    },
    "pos_transactions": {
      "schema": "POSTransaction",
      "description": "POS sales records."
    }
  }
}
